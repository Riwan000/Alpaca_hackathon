# ==============================================================================
# Autonomous Adaptive Portfolio Hedge Agent - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI / LLM Configuration
# ------------------------------------------------------------------------------
# LLM Provider toggle: 'openrouter' (development/testing) or 'featherless' (judging/final evaluation)
LLM_PROVIDER=openrouter

# OpenRouter Configuration (Development & Iterative Testing)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Featherless AI Configuration (Final Evaluation & Submission Benchmark)
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# ------------------------------------------------------------------------------
# 2. Alpaca Trading API & Market Data
# ------------------------------------------------------------------------------
# Paper Trading Account Credentials
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets/v2
ALPACA_PAPER=true

# ------------------------------------------------------------------------------
# 3. Database / Persistence (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_hedge
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 4. External Data Providers (Optional / Fallback)
# ------------------------------------------------------------------------------
FINNHUB_API_KEY=your_finnhub_api_key_here
NEWS_API_KEY=your_news_api_key_here

# ------------------------------------------------------------------------------
# 5. Backend Server & API
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 6. Risk Engine & Autonomous Hedge Parameters (Defaults)
# ------------------------------------------------------------------------------
# Maximum percentage of portfolio value allowed for hedge premium allocation (e.g. 0.05 = 5%)
MAX_HEDGE_BUDGET_PCT=0.05
# Drawdown threshold trigger for automatic reassessment (e.g. 0.05 = 5% drawdown)
DRAWDOWN_TRIGGER_PCT=0.05
# Hedge drift threshold trigger (e.g. 0.05 = 5% drift from target)
HEDGE_DRIFT_THRESHOLD_PCT=0.05
# Reassessment cooldown period in seconds (prevents overtrading)
REASSESSMENT_COOLDOWN_SECONDS=300
